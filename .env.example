PORT=3000
# --- Full puter.js: satu-satunya kredensial adalah PUTER_AUTH_TOKEN ---
# Isi token dari login Puter (getAuthToken).
PUTER_AUTH_TOKEN=
# Model chat teks->teks (daftar fallback koma: utama dulu, cadangan bila kena
# 402 kuota / 429 rate-limit / timeout / model tak dikenal). Bila kosong default gpt-5-nano.
LLM_MODEL=gpt-4o-mini
# Model vision untuk gambar->teks (daftar fallback koma, harus vision-capable;
# bila kosong default gpt-4o-mini).
VISION_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=90000
SYSTEM_PROMPT=Kamu asisten berbahasa Indonesia yang singkat dan membantu.
# --- Generate gambar (puter.ai.txt2img) ---
# Multi-model fallback: pisahkan dengan koma, dicoba berurutan sampai berhasil.
# Isi NAMA MODEL (contoh: gpt-image-1-mini), BUKAN nama provider (contoh salah: gemini, together, xai).
# Daftar ini dipakai teks->gambar DAN gambar->gambar (/edit + lampiran).
# Kuota 402 / 429 / timeout lanjut ke model berikut; auth 401 / filter langsung berhenti.
# Bila kosong dipakai default gpt-image-1-mini.
IMAGE_MODEL=gpt-image-1-mini
IMAGE_TIMEOUT_MS=120000
# Batas ukuran gambar lampiran (bytes, default 4 MiB). Diselaraskan dengan validasi client.
VISION_MAX_IMAGE_BYTES=4194304
